@model RegisterViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kayıt Ol - OBS Sınav Sistemi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #f4f7f6;
            display: flex;
            align-items: center;
            height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .register-card {
            max-width: 500px;
            width: 100%;
            margin: auto;
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            background: #fff;
        }

        .form-control {
            border-radius: 10px;
            padding: 12px;
            border: 1px solid #e0e0e0;
        }

            .form-control:focus {
                box-shadow: 0 0 0 0.25 margin-bottom: rgba(13, 110, 253, 0.1);
                border-color: #0d6efd;
            }

        .btn-register {
            border-radius: 10px;
            padding: 12px;
            font-weight: 600;
            background: #28a745;
            border: none;
            transition: all 0.3s;
        }

            .btn-register:hover {
                background: #218838;
                transform: translateY(-1px);
            }

        .register-header {
            background: #f8f9fa;
            border-radius: 20px 20px 0 0;
            padding: 25px;
            border-bottom: 1px solid #eee;
        }
    </style>
</head>
<body>
    <div class="card register-card">
        <div class="register-header text-center">
            <h4 class="mb-0 fw-bold text-dark">Akademisyen Kayıt</h4>
            <p class="text-muted small mb-0 mt-2">Sisteme erişmek için kimliğinizi doğrulayın</p>
        </div>
        <div class="card-body p-4">
            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label class="form-label text-secondary small fw-bold">Personel Kimliğiniz</label>
                    <select asp-for="PersonelID" class="form-select form-control"
                            asp-items="@(new SelectList(ViewBag.Personeller, "PersonelID", "Ad"))">
                        <option value="">Lütfen İsminizi Seçiniz...</option>
                    </select>
                    <span asp-validation-for="PersonelID" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-secondary small fw-bold">Kullanıcı Adı</label>
                    <input asp-for="KullaniciAdi" class="form-control" placeholder="Örn: hoca_admin" />
                    <span asp-validation-for="KullaniciAdi" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-secondary small fw-bold">Şifre</label>
                        <input asp-for="Sifre" type="password" class="form-control" />
                        <span asp-validation-for="Sifre" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-secondary small fw-bold">Şifre Tekrar</label>
                        <input asp-for="SifreTekrar" type="password" class="form-control" />
                        <span asp-validation-for="SifreTekrar" class="text-danger small"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-register w-100 text-white mt-2">Hesabımı Oluştur</button>

                <div class="text-center mt-4">
                    <span class="text-muted small">Zaten bir hesabınız var mı?</span>
                    <a asp-action="Login" class="text-primary text-decoration-none small fw-bold">Giriş Yap</a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>