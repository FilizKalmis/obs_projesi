@model OBS_Projesi.Models.Sinav

@{
    ViewData["Title"] = "Yeni Sınav Planla";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Yeni Sınav Planla</h2>
        <p class="text-muted mb-0">
            Ders, tarih ve oturum seçerek sınav programına yeni kayıt ekleyin.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <form asp-controller="Sinav" asp-action="Ekle" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-12">
                        <label asp-for="DersID" class="form-label fw-semibold"></label>
                        <select asp-for="DersID" asp-items="ViewBag.Dersler" class="form-select">
                            <option value="">Ders seçiniz</option>
                        </select>
                        <span asp-validation-for="DersID" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Tarih" class="form-label fw-semibold"></label>
                        <input asp-for="Tarih"
                               type="date"
                               class="form-control"
                               value="@Model.Tarih.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Tarih" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="OturumID" class="form-label fw-semibold"></label>
                        <select asp-for="OturumID" asp-items="ViewBag.Oturumlar" class="form-select">
                            <option value="">Oturum seçiniz</option>
                        </select>
                        <span asp-validation-for="OturumID" class="text-danger"></span>
                    </div>

                </div>

                <div class="alert alert-info border-0 mt-4">
                    Aynı yarıyıldaki dersler aynı tarih ve oturuma atanamaz.
                    Aynı yarıyıl için aynı güne en fazla 2 sınav planlanabilir.
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary px-4">
                        Kaydet
                    </button>

                    <a asp-controller="Sinav" asp-action="Index" class="btn btn-outline-secondary px-4">
                        İptal
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}