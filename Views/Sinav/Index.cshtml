@model List<OBS_Projesi.Models.Sinav>

@{
    ViewData["Title"] = "Sınav Planlama";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Sınav Planlama</h2>
            <p class="text-muted mb-0">
                Derslerin sınav tarihlerini ve oturumlarını çakışma kurallarına göre yönetin.
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Sinav" asp-action="Ekle" class="btn btn-primary px-4">
                + Yeni Sınav
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <p class="text-muted mb-1">Toplam Sınav</p>
                    <h3 class="fw-bold mb-0">@Model.Count</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <p class="text-muted mb-1">Bugünden Sonraki Sınav</p>
                    <h3 class="fw-bold mb-0">@Model.Count(x => x.Tarih.Date >= DateTime.Today)</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <p class="text-muted mb-1">Farklı Gün Sayısı</p>
                    <h3 class="fw-bold mb-0">@Model.Select(x => x.Tarih.Date).Distinct().Count()</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <h5 class="fw-bold mb-0">Sınav Programı</h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Tarih</th>
                            <th>Oturum</th>
                            <th>Saat</th>
                            <th>Ders Kodu</th>
                            <th>Ders Adı</th>
                            <th>Bölüm</th>
                            <th>Yarıyıl</th>
                            <th>Öğrenci</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var sinav in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">
                                        @sinav.Tarih.ToString("dd.MM.yyyy")
                                    </td>

                                    <td>
                                        @sinav.Oturum?.Tanim
                                    </td>

                                    <td>
                                        @sinav.Oturum?.BaslangicSaat.ToString(@"hh\:mm")
                                        -
                                        @sinav.Oturum?.BitisSaat.ToString(@"hh\:mm")
                                    </td>

                                    <td>
                                        @sinav.Ders?.DersKodu
                                    </td>

                                    <td>
                                        @sinav.Ders?.DersAdi
                                    </td>

                                    <td>
                                        @sinav.Ders?.Bolum?.BolumAdi
                                    </td>

                                    <td>
                                        @sinav.Ders?.Yariyil
                                    </td>

                                    <td>
                                        @sinav.Ders?.OgrenciSayisi
                                    </td>

                                    <td class="text-end pe-4">
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-controller="Sinav"
                                               asp-action="Duzenle"
                                               asp-route-id="@sinav.SinavID"
                                               class="btn btn-sm btn-outline-primary me-2">
                                                Düzenle
                                            </a>

                                            <form asp-controller="Sinav"
                                                  asp-action="Sil"
                                                  asp-route-id="@sinav.SinavID"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Bu sınavı silmek istediğinize emin misiniz?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    Sil
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Sadece görüntüleme</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-5">
                                    Henüz sınav planlanmamış.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>