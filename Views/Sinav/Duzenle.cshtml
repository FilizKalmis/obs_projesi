@model OBS_Projesi.Models.Sinav

@{
    ViewData["Title"] = "Sınav Düzenle";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Sınav Düzenle</h2>
        <p class="text-muted mb-0">
            Mevcut sınavın ders, tarih veya oturum bilgisini güncelleyin.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <form asp-controller="Sinav"
                  asp-action="Duzenle"
                  asp-route-id="@Model.SinavID"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="SinavID" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-12">
                        <label asp-for="DersID" class="form-label fw-semibold"></label>
                        <select asp-for="DersID" asp-items="ViewBag.Dersler" class="form-select">
                            <option value="">Ders seçiniz</option>
                        </select>
                        <span asp-validation-for="DersID" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Tarih" class="form-label fw-semibold"></label>
                        <input asp-for="Tarih"
                               type="date"
                               class="form-control"
                               value="@Model.Tarih.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Tarih" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="OturumID" class="form-label fw-semibold"></label>
                        <select asp-for="OturumID" asp-items="ViewBag.Oturumlar" class="form-select">
                            <option value="">Oturum seçiniz</option>
                        </select>
                        <span asp-validation-for="OturumID" class="text-danger"></span>
                    </div>

                </div>

                <div class="alert alert-info border-0 mt-4">
                    Güncelleme sırasında aynı yarıyıl, aynı gün ve aynı oturum çakışması tekrar kontrol edilir.
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary px-4">
                        Güncelle
                    </button>

                    <a asp-controller="Sinav" asp-action="Index" class="btn btn-outline-secondary px-4">
                        İptal
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}