@model OBS_Projesi.Models.GozetmenAtama

@{
    ViewData["Title"] = "Yeni Gözetmen Ataması";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Yeni Gözetmen Ataması</h2>
        <p class="text-muted mb-0">
            Seçilen sınav salonuna uygun bir gözetmen atayın.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <form asp-controller="GozetmenAtama" asp-action="Ekle" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-12">
                        <label asp-for="SinavSalonuID" class="form-label fw-semibold"></label>
                        <select asp-for="SinavSalonuID" asp-items="ViewBag.SinavSalonlari" class="form-select">
                            <option value="">Sınav salonu seçiniz</option>
                        </select>
                        <span asp-validation-for="SinavSalonuID" class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="PersonelID" class="form-label fw-semibold"></label>
                        <select asp-for="PersonelID" asp-items="ViewBag.Personeller" class="form-select">
                            <option value="">Gözetmen seçiniz</option>
                        </select>
                        <span asp-validation-for="PersonelID" class="text-danger"></span>
                    </div>

                </div>

                <div class="alert alert-info border-0 mt-4">
                    Aynı personel aynı tarih ve oturumda iki farklı salonda görevlendirilemez.
                    Personelin mazeret durumu ve görev çakışması kontrol edilir.
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary px-4">
                        Atama Yap
                    </button>

                    <a asp-controller="GozetmenAtama" asp-action="Index" class="btn btn-outline-secondary px-4">
                        İptal
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>