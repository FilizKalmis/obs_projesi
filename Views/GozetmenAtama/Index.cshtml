@model List<OBS_Projesi.Models.GozetmenAtama>

@{
    ViewData["Title"] = "Gözetmen Atama";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Gözetmen Atama</h2>
            <p class="text-muted mb-0">
                Sınav salonlarına gözetmen atayın ve görev çakışmalarını kontrol edin.
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="GozetmenAtama" asp-action="Ekle" class="btn btn-primary px-4">
                + Yeni Atama
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <p class="text-muted mb-1">Toplam Atama</p>
                    <h3 class="fw-bold mb-0">@Model.Count</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <p class="text-muted mb-1">Görev Alan Personel</p>
                    <h3 class="fw-bold mb-0">@Model.Select(x => x.PersonelID).Distinct().Count()</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <p class="text-muted mb-1">Atama Yapılan Salon</p>
                    <h3 class="fw-bold mb-0">@Model.Select(x => x.SinavSalonuID).Distinct().Count()</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <h5 class="fw-bold mb-0">Gözetmen Atama Listesi</h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Tarih</th>
                            <th>Oturum</th>
                            <th>Ders</th>
                            <th>Salon</th>
                            <th>Gözetmen</th>
                            <th>Bölüm</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var atama in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">
                                        @atama.SinavSalonu.Sinav.Tarih.ToString("dd.MM.yyyy")
                                    </td>

                                    <td>
                                        @atama.SinavSalonu.Sinav.Oturum.Tanim
                                        <span class="text-muted small">
                                            (@atama.SinavSalonu.Sinav.Oturum.BaslangicSaat.ToString(@"hh\:mm")
                                            -
                                            @atama.SinavSalonu.Sinav.Oturum.BitisSaat.ToString(@"hh\:mm"))
                                        </span>
                                    </td>

                                    <td>
                                        @atama.SinavSalonu.Sinav.Ders.DersKodu -
                                        @atama.SinavSalonu.Sinav.Ders.DersAdi
                                    </td>

                                    <td>
                                        @atama.SinavSalonu.Derslik.Ad
                                    </td>

                                    <td>
                                        @atama.Personel.Unvan @atama.Personel.Ad @atama.Personel.Soyad
                                    </td>

                                    <td>
                                        @atama.Personel.Bolum?.BolumAdi
                                    </td>

                                    <td class="text-end pe-4">
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <form asp-controller="GozetmenAtama"
                                                  asp-action="Sil"
                                                  asp-route-id="@atama.AtamaID"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Bu gözetmen atamasını kaldırmak istediğinize emin misiniz?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    Kaldır
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Sadece görüntüleme</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    Henüz gözetmen ataması yapılmamış.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>