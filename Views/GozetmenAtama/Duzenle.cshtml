@model OBS_Projesi.Models.GozetmenAtama

@{
    ViewData["Title"] = "Gözetmen Atamasını Düzenle";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Gözetmen Atamasını Düzenle</h2>
        <p class="text-muted mb-0">
            Sınav salonuna atanmış gözetmeni veya sınav salonunu güncelleyin.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <form asp-controller="GozetmenAtama"
                  asp-action="Duzenle"
                  asp-route-id="@Model.AtamaID"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="AtamaID" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-12">
                        <label asp-for="SinavSalonuID" class="form-label fw-semibold">
                            Sınav Salonu
                        </label>

                        <select asp-for="SinavSalonuID"
                                asp-items="ViewBag.SinavSalonlari"
                                class="form-select">
                            <option value="">Sınav salonu seçiniz</option>
                        </select>

                        <span asp-validation-for="SinavSalonuID" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="PersonelID" class="form-label fw-semibold">
                            Gözetmen
                        </label>

                        <select asp-for="PersonelID"
                                asp-items="ViewBag.Personeller"
                                class="form-select">
                            <option value="">Gözetmen seçiniz</option>
                        </select>

                        <span asp-validation-for="PersonelID" class="text-danger small"></span>
                    </div>

                </div>

                <div class="alert alert-info border-0 mt-4 mb-0">
                    <div class="fw-semibold mb-1">
                        <i class="bi bi-info-circle me-1"></i>Atama Kontrolleri
                    </div>

                    <div>
                        Sistem aynı tarih ve oturumda görev çakışmasını, personel mazeretini
                        ve arka arkaya 3 oturum sınırını kontrol eder.
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i>Güncelle
                    </button>

                    <a asp-controller="GozetmenAtama"
                       asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        İptal
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}