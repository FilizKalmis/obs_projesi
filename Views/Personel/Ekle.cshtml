@model OBS_Projesi.Models.Personel

@{
    ViewData["Title"] = "Yeni Personel Kaydı";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow border-0 mt-3">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="card-title mb-0"><i class="bi bi-person-add me-2"></i>Yeni Personel Tanımla</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Ekle" method="post">
                    @* GÜVENLİK: CSRF saldırılarını engellemek için Token üretir *@
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Unvan" class="form-label fw-bold"></label>
                            <select asp-for="Unvan" class="form-select">
                                <option value="">Seçiniz...</option>
                                <option value="Prof. Dr.">Prof. Dr.</option>
                                <option value="Doç. Dr.">Doç. Dr.</option>
                                <option value="Dr. Öğr. Üyesi">Dr. Öğr. Üyesi</option>
                                <option value="Arş. Gör.">Arş. Gör.</option>
                                <option value="Öğr. Gör.">Öğr. Gör.</option>
                            </select>
                            <span asp-validation-for="Unvan" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8 mb-3">
                            <label asp-for="BolumID" class="form-label fw-bold">Bağlı Olduğu Bölüm</label>
                            <select asp-for="BolumID" class="form-select" asp-items="ViewBag.Bolumler">
                                <option value="">Bölüm Seçiniz...</option>
                            </select>
                            <span asp-validation-for="BolumID" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Ad" class="form-label fw-bold"></label>
                        <input asp-for="Ad" class="form-control" placeholder="Personel adını giriniz" />
                        <span asp-validation-for="Ad" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Soyad" class="form-label fw-bold"></label>
                        <input asp-for="Soyad" class="form-control" placeholder="Personel soyadını giriniz" />
                        <span asp-validation-for="Soyad" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                        <a asp-action="Index" class="btn btn-light me-md-2">İptal</a>
                        <button type="submit" class="btn btn-primary px-5">
                            <i class="bi bi-save me-1"></i>Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}