@model IEnumerable<OBS_Projesi.Models.Personel>

@{
    ViewData["Title"] = "Personel Listesi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-people-fill me-2"></i>Personel (Gözetmen) Listesi</h2>
    <a asp-action="Ekle" class="btn btn-success">
        <i class="bi bi-person-plus-fill me-1"></i>Yeni Personel Ekle
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Unvan</th>
                        <th>Ad</th>
                        <th>Soyad</th>
                        <th>Bölüm</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Unvan</td>
                            <td>@item.Ad</td>
                            <td>@item.Soyad</td>
                            <td>@(item.Bolum?.BolumAdi ?? "Belirtilmemiş")</td>
                            <td class="text-center">
                                <a asp-action="Duzenle" asp-route-id="@item.PersonelID" class="btn btn-sm btn-outline-primary border-0" title="Düzenle">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Mazeretler" asp-route-id="@item.PersonelID" class="btn btn-sm btn-outline-warning border-0" title="Mazeretler">
                                    <i class="bi bi-calendar-x"></i>
                                </a>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>