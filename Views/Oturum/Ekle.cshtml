@model OBS_Projesi.Models.Oturum

@{
    ViewData["Title"] = "Yeni Oturum Ekle";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Yeni Oturum Ekle</h2>
        <p class="text-muted mb-0">
            Sınavların atanacağı sabit saat aralığını oluşturun.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <form asp-controller="Oturum" asp-action="Ekle" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-12">
                        <label asp-for="Tanim" class="form-label fw-semibold"></label>
                        <input asp-for="Tanim"
                               class="form-control"
                               placeholder="Örn: Sabah-1, Sabah-2, Öğleden Sonra-1" />
                        <span asp-validation-for="Tanim" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="BaslangicSaat" class="form-label fw-semibold"></label>
                        <input asp-for="BaslangicSaat"
                               type="time"
                               class="form-control" />
                        <span asp-validation-for="BaslangicSaat" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="BitisSaat" class="form-label fw-semibold"></label>
                        <input asp-for="BitisSaat"
                               type="time"
                               class="form-control" />
                        <span asp-validation-for="BitisSaat" class="text-danger"></span>
                    </div>

                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary px-4">
                        Kaydet
                    </button>

                    <a asp-controller="Oturum" asp-action="Index" class="btn btn-outline-secondary px-4">
                        İptal
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}