<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OBS Sınav Planlama</title>

    <!-- Yerel Bootstrap CSS (Projende var olan) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Yerel Özel CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Bootstrap İkonları (Görsellik katmak için) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="bg-light">
    <header>
        <!-- Modern, koyu mavi (bg-primary) bir navigasyon menüsü -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-4">
            <div class="container-fluid">
                <!-- Proje Logo/İsmi -->
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-calendar-check me-2"></i>Sınav Planlama Sistemi
                </a>

                <!-- Mobil görünümler için açılır menü butonu -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Menüyü Aç">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Anasayfa</a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <!-- Herkesin görebileceği kısımlar -->
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Sinav" asp-action="Program">Sınav Programı</a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <!-- Sadece Admin'in (App_Admin) görebileceği kısımlar -->
                                <li class="nav-item">
                                    <a class="nav-link text-danger fw-bold" asp-controller="Sinav" asp-action="Olustur">Yeni Sınav / Salon Ata</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Personel" asp-action="Liste">Personel Yönetimi</a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-primary">Merhaba, @User.Identity.Name (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn btn-link text-dark" asp-controller="Account" asp-action="Logout">Çıkış</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                            </li>
                        }
                    </ul>

                    <!-- Sağ Taraf (Kullanıcı Girişi / Admin Göstergesi) -->
                    <div class="d-flex text-white align-items-center">
                        <i class="bi bi-person-circle fs-5 me-2"></i>
                        <span>Admin Kullanıcısı</span>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Sayfa İçeriğinin Geleceği Ana Konteyner -->
    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Alt Bilgi (Footer) -->
    <footer class="border-top footer text-muted bg-white mt-auto py-3">
        <div class="container text-center">
            &copy; 2026 - YZM 2126 Sınav Planlama ve Gözetmen Atama Sistemi
        </div>
    </footer>

    <!-- Yerel JS Kütüphaneleri (Projende var olan) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- İlgili sayfalarda özel JS kodları kullanabilmek için -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>