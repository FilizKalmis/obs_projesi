namespace OBS_Projesi.Views.Derslik
@model OBS_Projesi.Models.Derslik

@{
    ViewData["Title"] = "Yeni Derslik Ekle";
}

<h2>Yeni Derslik Tanımla</h2>

<div class="row">
    <div class="col-md-6 shadow-sm p-4 bg-white rounded">
        <form asp-action="Ekle" method="post">
            <!-- Formun içine gizli bir güvenlik token'ı yerleştirir -->
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Ad" class="form-label"></label>
                <input asp-for="Ad" class="form-control" placeholder="Örn: Amfi-1" />
                <span asp-validation-for="Ad" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Kapasite" class="form-label"></label>
                <input asp-for="Kapasite" type="number" class="form-control" />
                <span asp-validation-for="Kapasite" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Tip" class="form-label"></label>
                <select asp-for="Tip" class="form-select">
                    <option value="Amfi">Büyük Amfi</option>
                    <option value="Sınıf">Sınıf</option>
                    <option value="Lab">Laboratuvar</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a asp-action="Index" class="btn btn-secondary">İptal</a>
        </form>
    </div>
</div>
