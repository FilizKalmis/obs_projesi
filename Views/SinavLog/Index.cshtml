@model List<OBS_Projesi.Models.SinavLog>

@{
    ViewData["Title"] = "Log Kayıtları";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Log Kayıtları</h2>
            <p class="text-muted mb-0">
                Sınav işlemlerinde yapılan değişiklikleri, eski ve yeni değerleriyle takip edin.
            </p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <p class="text-muted mb-1">Toplam Log</p>
                    <h3 class="fw-bold mb-0">@Model.Count</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <p class="text-muted mb-1">Bugünkü Log</p>
                    <h3 class="fw-bold mb-0">
                        @Model.Count(x => x.IslemTarihi.Date == DateTime.Today)
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <p class="text-muted mb-1">İşlem Türü Sayısı</p>
                    <h3 class="fw-bold mb-0">
                        @Model.Select(x => x.IslemTuru).Distinct().Count()
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <h5 class="fw-bold mb-0">Sınav İşlem Logları</h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">İşlem Tarihi</th>
                            <th>İşlem Türü</th>
                            <th>Sınav</th>
                            <th>Eski Değer</th>
                            <th>Yeni Değer</th>
                            <th>Değiştiren</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var log in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">
                                        @log.IslemTarihi.ToString("dd.MM.yyyy HH:mm")
                                    </td>

                                    <td>
                                        <span class="badge bg-primary">
                                            @log.IslemTuru
                                        </span>
                                    </td>

                                    <td>
                                        @if (log.Sinav != null)
                                        {
                                            <span>
                                                @log.Sinav.Ders?.DersKodu -
                                                @log.Sinav.Ders?.DersAdi
                                            </span>
                                            <br />
                                            <small class="text-muted">
                                                @log.Sinav.Tarih.ToString("dd.MM.yyyy")
                                                |
                                                @log.Sinav.Oturum?.Tanim
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sınav bilgisi yok</span>
                                        }
                                    </td>

                                    <td>
                                        <span class="log-value old-value">
                                            @log.EskiDeger
                                        </span>
                                    </td>

                                    <td>
                                        <span class="log-value new-value">
                                            @log.YeniDeger
                                        </span>
                                    </td>

                                    <td>
                                        @if (log.DegistirenPersonel != null)
                                        {
                                            <span>
                                                @log.DegistirenPersonel.Unvan
                                                @log.DegistirenPersonel.Ad
                                                @log.DegistirenPersonel.Soyad
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sistem/Admin</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    Henüz log kaydı bulunmamaktadır.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>