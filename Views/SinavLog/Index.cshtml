@model List<OBS_Projesi.Models.SinavLog>

@{
    ViewData["Title"] = "Log Kayıtları";
    var loglar = Model ?? new List<OBS_Projesi.Models.SinavLog>();
}

<div class="page-header">
    <div>
        <h2>Log Kayıtları</h2>
        <p>Sınav değişiklik geçmişi</p>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <span>Toplam Kayıt</span>
        <h3>@loglar.Count</h3>
    </div>

    <div class="stat-card">
        <span>Bugünkü Kayıt</span>
        <h3>@loglar.Count(x => x.IslemTarihi.Date == DateTime.Today)</h3>
    </div>

    <div class="stat-card">
        <span>İşlem Türü</span>
        <h3>@loglar.Select(x => x.IslemTuru).Distinct().Count()</h3>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5>Sınav Değişiklikleri</h5>
        <span class="viewer-badge">@loglar.Count kayıt</span>
    </div>

    @if (loglar.Any())
    {
        <div class="table-responsive">
            <table class="table custom-table">
                <thead>
                    <tr>
                        <th>İşlem Tarihi</th>
                        <th>İşlem</th>
                        <th>Sınav</th>
                        <th>Eski Değer</th>
                        <th>Yeni Değer</th>
                        <th>Değiştiren</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var log in loglar)
                    {
                        <tr>
                            <td>@log.IslemTarihi.ToString("dd.MM.yyyy HH:mm")</td>

                            <td>
                                <span class="viewer-badge">@log.IslemTuru</span>
                            </td>

                            <td>
                                @if (log.Sinav != null)
                                {
                                    <div>
                                        <strong>@log.Sinav.Ders?.DersKodu - @log.Sinav.Ders?.DersAdi</strong>
                                    </div>
                                    <small class="text-muted">
                                        @log.Sinav.Tarih.ToString("dd.MM.yyyy") / @log.Sinav.Oturum?.Tanim
                                    </small>
                                }
                                else
                                {
                                    <span class="text-muted">Sınav bilgisi yok</span>
                                }
                            </td>

                            <td>@log.EskiDeger</td>

                            <td>@log.YeniDeger</td>

                            <td>
                                @if (log.DegistirenPersonel != null)
                                {
                                    <span>
                                        @log.DegistirenPersonel.Unvan
                                        @log.DegistirenPersonel.Ad
                                        @log.DegistirenPersonel.Soyad
                                    </span>
                                }
                                else
                                {
                                    <span>Sistem</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            Henüz kayıt bulunmamaktadır.
        </div>
    }
</div>